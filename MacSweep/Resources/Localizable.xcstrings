    "No cleanup items were found. Nothing will be removed without your review and approval." : {
      "extractionState" : "stale",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не бяха намерени елементи за почистване. Нищо няма да бъде премахнато без вашия преглед и одобрение."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nebyly nalezeny žádné předměty pro úklid. Bez vaší kontroly a schválení nebude nic odstraněno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der blev ikke fundet nogen oprydningsgenstande. Intet vil blive fjernet uden din gennemgang og godkendelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurden keine Bereinigungselemente gefunden. Ohne Ihre Überprüfung und Genehmigung wird nichts entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν βρέθηκαν στοιχεία καθαρισμού. Τίποτα δεν θα αφαιρεθεί χωρίς τον έλεγχο και την έγκρισή σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No cleanup items were found. Nothing will be removed without your review and approval."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontraron elementos de limpieza. No se eliminará nada sin su revisión y aprobación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puhastusesemeid ei leitud. Midagi ei eemaldata ilma teie ülevaatuse ja nõusolekuta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siivouskohteita ei löytynyt. Mitään ei poisteta ilman tarkistusta ja hyväksyntääsi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun élément de nettoyage n'a été trouvé. Rien ne sera supprimé sans votre examen et votre approbation."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níor aimsíodh aon earraí glanta. Ní bhainfear aon rud gan do athbhreithniú agus faomhadh."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सफाई का कोई सामान नहीं मिला. आपकी समीक्षा और अनुमोदन के बिना कुछ भी नहीं हटाया जाएगा."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nisu pronađeni predmeti za čišćenje. Ništa neće biti uklonjeno bez vašeg pregleda i odobrenja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem található tisztítóelem. Az Ön ellenőrzése és jóváhagyása nélkül semmit nem távolítunk el."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato trovato alcun elemento di pulizia. Niente verrà rimosso senza la tua revisione e approvazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリーンアップ項目が見つかりませんでした。あなたのレビューと承認なしに何も削除されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정리 항목이 발견되지 않았습니다. 귀하의 검토 및 승인 없이는 아무것도 제거되지 않습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valymo elementų nerasta. Niekas nebus pašalintas be jūsų peržiūros ir patvirtinimo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tīrīšanas vienumi netika atrasti. Nekas netiks noņemts bez jūsu pārskatīšanas un apstiprinājuma."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
