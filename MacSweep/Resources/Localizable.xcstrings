    "Moved %@ to external drive.\nA symbolic link was created — %@ will work normally." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ е преместен на външно устройство.\nСъздадена е символична връзка — %@ ще работи нормално."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přesunuto %@ na externí disk.\nByl vytvořen symbolický odkaz — %@ bude fungovat normálně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyttet %@ til eksternt drev.\nEt symbolsk link blev oprettet — %@ vil fungere normalt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ auf externes Laufwerk verschoben.\nEs wurde ein symbolischer Link erstellt – %@ funktioniert normal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ μεταφέρθηκε σε εξωτερική μονάδα δίσκου.\nΔημιουργήθηκε ένας συμβολικός σύνδεσμος — Το %@ θα λειτουργεί κανονικά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Moved %1$@ to external drive.\nA symbolic link was created — %2$@ will work normally."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se movió %@ a una unidad externa.\nSe creó un enlace simbólico: %@ funcionará normalmente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ teisaldati välisele draivile.\nLoodi sümboolne link — %@ töötab normaalselt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirretty %@ ulkoiseen asemaan.\nSymbolinen linkki luotiin — %@ toimii normaalisti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacement de %@ vers un lecteur externe.\nUn lien symbolique a été créé — %@ fonctionnera normalement."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bogtha %@ chuig tiomántán seachtrach.\nCruthaíodh nasc siombalach — oibreoidh %@ de ghnáth."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ को बाहरी ड्राइव पर ले जाया गया।\nएक प्रतीकात्मक लिंक बनाया गया - %@ सामान्य रूप से काम करेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ premješten na vanjski pogon.\nStvorena je simbolička veza — %@ će raditi normalno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %@ áthelyezése külső meghajtóra.\nEgy szimbolikus hivatkozás jött létre – a %@ normálisan fog működni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ spostato sull'unità esterna.\nÈ stato creato un collegamento simbolico: %@ funzionerà normalmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を外部ドライブに移動しました。\nシンボリック リンクが作成されました。%@ は正常に動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@를 외부 드라이브로 옮겼습니다.\n심볼릭 링크가 생성되었습니다. %@가 정상적으로 작동합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ perkeltas į išorinį diską.\nSukurta simbolinė nuoroda – %@ veiks normaliai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārvietots %@ uz ārējo disku.\nTika izveidota simboliska saite — %@ darbosies normāli."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tċaqlaq %@ għal drive estern.\nInħolqot rabta simbolika — %@ jaħdem b'mod normali."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
