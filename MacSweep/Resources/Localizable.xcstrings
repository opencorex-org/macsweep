    "Only strongly matched app data is included. Shared package receipts, system files, and ambiguous vendor SDKs are preserved." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включени са само данни за приложения със силно съответствие. Споделените разписки за пакети, системните файлове и двусмислените SDK на доставчици се запазват."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jsou zahrnuta pouze pevně shodná data aplikací. Sdílené příjemky balíčků, systémové soubory a nejednoznačné sady SDK dodavatelů jsou zachovány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun stærkt matchede appdata er inkluderet. Delte pakkekvitteringer, systemfiler og tvetydige leverandør-SDK'er bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sind nur stark übereinstimmende App-Daten enthalten. Gemeinsame Paketbelege, Systemdateien und mehrdeutige Anbieter-SDKs bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περιλαμβάνονται μόνο ισχυρά αντιστοιχισμένα δεδομένα εφαρμογής. Οι κοινόχρηστες αποδείξεις πακέτων, τα αρχεία συστήματος και τα διφορούμενα SDK προμηθευτών διατηρούνται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only strongly matched app data is included. Shared package receipts, system files, and ambiguous vendor SDKs are preserved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se incluyen datos de aplicaciones fuertemente coincidentes. Se conservan los recibos de paquetes compartidos, los archivos del sistema y los SDK de proveedores ambiguos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaasatakse ainult tugeva vastega rakenduse andmed. Säilitatakse jagatud pakkide kviitungid, süsteemifailid ja mitmetähenduslikud tarnija SDK-d."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain vahvasti vastaavat sovellustiedot sisältyvät. Jaetut pakettikuitit, järjestelmätiedostot ja moniselitteiset toimittajien SDK:t säilyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les données d'application fortement correspondantes sont incluses. Les reçus de colis partagés, les fichiers système et les SDK ambigus des fournisseurs sont préservés."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní áirítear ach sonraí aipe a mheaitseálann go láidir. Caomhnaítear admhálacha pacáiste roinnte, comhaid chórais, agus SDKanna díoltóirí débhríoch."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल दृढ़ता से मेल खाने वाला ऐप डेटा शामिल किया गया है। साझा पैकेज रसीदें, सिस्टम फ़ाइलें और अस्पष्ट विक्रेता एसडीके संरक्षित हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uključeni su samo podaci aplikacije koji se dobro podudaraju. Potvrde dijeljenih paketa, sistemske datoteke i dvosmisleni SDK-ovi dobavljača su sačuvani."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak az erősen egyező alkalmazásadatok szerepelnek benne. A megosztott csomagnyugták, a rendszerfájlok és a kétértelmű szállítói SDK-k megmaradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono inclusi solo i dati delle app con corrispondenza forte. Le ricevute dei pacchetti condivisi, i file di sistema e gli SDK dei fornitori ambigui vengono conservati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強く一致するアプリ データのみが含まれます。共有パッケージ受領書、システム ファイル、およびあいまいなベンダー SDK は保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강력하게 일치하는 앱 데이터만 포함됩니다. 공유 패키지 영수증, 시스템 파일, 모호한 공급업체 SDK가 보존됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įtraukiami tik tiksliai atitinkantys programos duomenys. Išsaugomi bendrinami paketo kvitai, sistemos failai ir dviprasmiški tiekėjo SDK."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiek iekļauti tikai precīzi atbilstoši lietotņu dati. Tiek saglabāti koplietotie pakotņu kvītis, sistēmas faili un neskaidri piegādātāju SDK."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Id-dejta tal-app li tkun imqabbla b'mod qawwi biss hija inkluża. Irċevuti tal-pakketti kondiviżi, fajls tas-sistema, u SDKs ambigwi tal-bejjiegħ huma ppreservati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen sterk overeenkomende app-gegevens worden opgenomen. Gedeelde pakketbewijzen, systeembestanden en dubbelzinnige SDK's van leveranciers blijven behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwzględniane są tylko ściśle dopasowane dane aplikacji. Udostępnione potwierdzenia pakietów, pliki systemowe i niejednoznaczne zestawy SDK dostawców zostają zachowane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas dados de aplicativos com correspondência forte são incluídos. Recibos de pacotes compartilhados, arquivos de sistema e SDKs de fornecedores ambíguos são preservados."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas dados de aplicativos com correspondência forte são incluídos. Recibos de pacotes compartilhados, arquivos de sistema e SDKs de fornecedores ambíguos são preservados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunt incluse doar datele aplicației cu potrivire puternică. Chitanțe de pachete partajate, fișiere de sistem și SDK-uri ambigue ale furnizorului sunt păstrate."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "දැඩි ලෙස ගැළපෙන යෙදුම් දත්ත පමණක් ඇතුළත් වේ. බෙදාගත් පැකේජ රිසිට්පත්, පද්ධති ගොනු සහ අපැහැදිලි වෙළෙන්දා SDK සංරක්ෂණය කර ඇත."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahrnuté sú iba silne zhodné údaje aplikácie. Zdieľané potvrdenia o balíkoch, systémové súbory a nejednoznačné súpravy SDK dodávateľov sú zachované."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vključeni so samo podatki o aplikacijah, ki se močno ujemajo. Potrdila o paketih v skupni rabi, sistemske datoteke in dvoumni SDK-ji dobaviteljev so ohranjeni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast starkt matchad appdata ingår. Delade paketkvitton, systemfiler och tvetydiga leverantörs-SDK:er bevaras."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வலுவாகப் பொருந்திய பயன்பாட்டுத் தரவு மட்டுமே சேர்க்கப்பட்டுள்ளது. பகிரப்பட்ட தொகுப்பு ரசீதுகள், கணினி கோப்புகள் மற்றும் தெளிவற்ற விற்பனையாளர் SDKகள் பாதுகாக்கப்படுகின்றன."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅包含强匹配的应用程序数据。保留共享包收据、系统文件和不明确的供应商 SDK。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅包含強匹配的應用程式資料。保留共享包收據、系統檔案和不明確的供應商 SDK。"
          }
        }
      }
    },
