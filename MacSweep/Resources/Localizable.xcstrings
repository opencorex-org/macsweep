    "A focused macOS utility for understanding storage, removing clutter, and keeping developer workspaces tidy." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фокусирана помощна програма за macOS за разбиране на съхранението, премахване на бъркотията и поддържане на работните пространства на разработчиците подредени."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaměřená utilita pro macOS pro pochopení úložiště, odstranění nepořádku a udržení pořádku na vývojářských pracovních plochách."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et fokuseret macOS-værktøj til at forstå lagring, fjerne rod og holde udviklerarbejdsområder ryddelige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein fokussiertes macOS-Dienstprogramm zum Verständnis des Speichers, zum Entfernen von Unordnung und zum Aufräumen von Entwicklerarbeitsplätzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα εστιασμένο βοηθητικό πρόγραμμα macOS για την κατανόηση της αποθήκευσης, την αφαίρεση της ακαταστασίας και τη διατήρηση τακτοποιημένου χώρου εργασίας προγραμματιστή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A focused macOS utility for understanding storage, removing clutter, and keeping developer workspaces tidy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una utilidad de macOS enfocada en comprender el almacenamiento, eliminar el desorden y mantener ordenados los espacios de trabajo de los desarrolladores."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontsentreeritud macOS-i utiliit salvestusruumi mõistmiseks, segaduse eemaldamiseks ja arendaja tööruumide korrashoidmiseks."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keskitetty macOS-apuohjelma tallennustilan ymmärtämiseen, sotkujen poistamiseen ja kehittäjien työtilojen pitämiseen siistinä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un utilitaire macOS ciblé pour comprendre le stockage, supprimer l'encombrement et garder les espaces de travail des développeurs bien rangés."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fóntas macOS dírithe chun stóráil a thuiscint, tranglam a bhaint agus spásanna oibre forbróra a choinneáil slachtmhar."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भंडारण को समझने, अव्यवस्था को दूर करने और डेवलपर कार्यस्थानों को साफ-सुथरा रखने के लिए एक केंद्रित macOS उपयोगिता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usmjereni macOS uslužni program za razumijevanje pohrane, uklanjanje nereda i održavanje urednih radnih prostora programera."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy fókuszált macOS-segédprogram a tárolás megértéséhez, a rendetlenség eltávolításához és a fejlesztői munkaterületek rendben tartásához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un'utilità macOS mirata per comprendere l'archiviazione, rimuovere il disordine e mantenere in ordine gli spazi di lavoro degli sviluppatori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストレージを理解し、散らかったものを取り除き、開発者のワークスペースを整理整頓した状態に保つための、集中的な macOS ユーティリティ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스토리지를 이해하고, 불필요한 요소를 제거하고, 개발자 작업 공간을 깔끔하게 유지하기 위한 집중 macOS 유틸리티입니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tikslinga „MacOS“ programa, skirta suprasti saugyklą, pašalinti netvarką ir palaikyti tvarkingą kūrėjų darbo vietas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncentrēta macOS utilīta, lai izprastu krātuvi, novērstu jucekli un uzturētu sakārtotas izstrādātāju darbvietas."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilità macOS iffukata biex tifhem il-ħażna, tneħħi l-imbarazz, u żżomm l-ispazji tax-xogħol tal-iżviluppaturi ordinati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een gericht macOS-hulpprogramma voor inzicht in opslag, het verwijderen van rommel en het netjes houden van de werkruimte van ontwikkelaars."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skoncentrowane narzędzie dla systemu MacOS umożliwiające zrozumienie pamięci masowej, usuwanie bałaganu i utrzymywanie porządku w obszarach roboczych programistów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um utilitário macOS focado para compreender o armazenamento, eliminar a desordem e manter os espaços de trabalho dos desenvolvedores organizados."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um utilitário macOS focado para compreender o armazenamento, eliminar a desordem e manter os espaços de trabalho dos desenvolvedores organizados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un utilitar macOS concentrat pentru înțelegerea stocării, eliminarea dezordinei și menținerea ordonată a spațiilor de lucru pentru dezvoltatori."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ගබඩා කිරීම අවබෝධ කර ගැනීම, අවුල් සහගත බව ඉවත් කිරීම සහ සංවර්ධක වැඩබිම් පිළිවෙලට තබා ගැනීම සඳහා නාභිගත macOS උපයෝගීතාවකි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zameraná pomôcka pre macOS na pochopenie úložiska, odstránenie neporiadku a udržiavanie poriadku v pracovných priestoroch vývojárov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osredotočen pripomoček macOS za razumevanje shranjevanja, odstranjevanje nereda in vzdrževanje urejenosti delovnih prostorov razvijalcev."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett fokuserat macOS-verktyg för att förstå lagring, ta bort skräp och hålla ordning på utvecklarens arbetsytor."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சேமிப்பகத்தைப் புரிந்துகொள்வதற்கும், ஒழுங்கீனத்தை அகற்றுவதற்கும், டெவலப்பர் பணியிடங்களை நேர்த்தியாக வைத்திருப்பதற்கும் ஒரு கவனம் செலுத்தப்பட்ட macOS பயன்பாடு."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一款专注于 macOS 的实用程序，用于了解存储、消除混乱并保持开发人员工作空间整洁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一款專注於 macOS 的實用程序，用於了解儲存、消除混亂並保持開發人員工作空間整潔。"
          }
        }
      }
    },
