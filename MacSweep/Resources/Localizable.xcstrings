    "Select only files you are comfortable regenerating. Approved items are permanently deleted." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете само файлове, които ви е удобно да регенерирате. Одобрените елементи се изтриват за постоянно."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte pouze soubory, které vám vyhovuje regenerovat. Schválené položky jsou trvale smazány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg kun filer, du er komfortabel med at regenerere. Godkendte varer slettes permanent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie nur Dateien aus, die Sie gerne neu generieren möchten. Genehmigte Elemente werden dauerhaft gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε μόνο αρχεία που αναπαράγετε άνετα. Τα εγκεκριμένα στοιχεία διαγράφονται οριστικά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select only files you are comfortable regenerating. Approved items are permanently deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleccione sólo los archivos que se sienta cómodo regenerando. Los elementos aprobados se eliminan permanentemente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valige ainult failid, mida on mugav taastada. Heakskiidetud üksused kustutatakse jäädavalt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse vain tiedostot, jotka haluat palauttaa. Hyväksytyt kohteet poistetaan pysyvästi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez uniquement les fichiers que vous êtes à l'aise de régénérer. Les éléments approuvés sont définitivement supprimés."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roghnaigh ach comhaid a bhfuil tú compordach a athghiniúint. Déantar míreanna ceadaithe a scriosadh go buan."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल उन्हीं फ़ाइलों का चयन करें जिन्हें आप पुन: उत्पन्न करने में सहज हैं। स्वीकृत आइटम स्थायी रूप से हटा दिए जाते हैं."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite samo datoteke koje želite regenerirati. Odobrene stavke trajno se brišu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak olyan fájlokat válasszon, amelyeket kényelmesen újra tud készíteni. A jóváhagyott elemek véglegesen törlődnek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona solo i file che sei disposto a rigenerare. Gli elementi approvati vengono eliminati definitivamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生成しても問題のないファイルのみを選択してください。承認されたアイテムは完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 생성하기에 편한 파일만 선택하세요. 승인된 항목은 영구적으로 삭제됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasirinkite tik tuos failus, kuriuos norite atkurti. Patvirtinti elementai ištrinami visam laikui."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atlasiet tikai tos failus, kurus vēlaties atjaunot. Apstiprinātie vienumi tiek neatgriezeniski izdzēsti."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agħżel biss fajls li inti komdu jirriġeneraw. L-oġġetti approvati jitħassru b'mod permanenti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecteer alleen bestanden die u gemakkelijk opnieuw kunt genereren. Goedgekeurde items worden definitief verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz tylko pliki, które możesz łatwo regenerować. Zatwierdzone elementy są trwale usuwane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione apenas os arquivos que você se sente confortável em regenerar. Os itens aprovados são excluídos permanentemente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione apenas os arquivos que você se sente confortável em regenerar. Os itens aprovados são excluídos permanentemente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selectați numai fișierele pe care vă simțiți confortabil să le regenerați. Elementele aprobate sunt șterse definitiv."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබට නැවත උත්පාදනය කිරීමට පහසු ගොනු පමණක් තෝරන්න. අනුමත අයිතම ස්ථිරවම මකනු ලැබේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte iba súbory, ktoré vám vyhovuje regenerovať. Schválené položky sa natrvalo odstránia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izberite samo datoteke, ki jih želite obnoviti. Odobreni predmeti so trajno izbrisani."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj bara filer som du är bekväm med att återskapa. Godkända objekt raderas permanent."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் மீண்டும் உருவாக்க வசதியாக இருக்கும் கோப்புகளை மட்டும் தேர்ந்தெடுக்கவும். அங்கீகரிக்கப்பட்ட உருப்படிகள் நிரந்தரமாக நீக்கப்படும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅选择您愿意重新生成的文件。批准的项目将被永久删除。"
          }
        },
        "zh-Hant" : {
