          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vizualizați toate unitățile interne și externe, utilizarea acestora și cele mai mari foldere de pe fiecare volum."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබගේ සියලුම අභ්‍යන්තර සහ බාහිර ධාවක, ඒවායේ භාවිතය සහ එක් එක් වෙළුම මත ඇති විශාලතම ෆෝල්ඩර බලන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazte všetky svoje interné a externé disky, ich využitie a najväčšie priečinky na každom zväzku."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oglejte si vse svoje notranje in zunanje pogone, njihovo uporabo in največje mape na vsakem nosilcu."
