        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείτε όλες τις εσωτερικές και εξωτερικές μονάδες δίσκου, τη χρήση τους και τους μεγαλύτερους φακέλους σε κάθε τόμο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "View all your internal and external drives, their usage, and the largest folders on each volume."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vea todas sus unidades internas y externas, su uso y las carpetas más grandes de cada volumen."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaadake kõiki oma sisemisi ja väliseid draive, nende kasutust ja iga köite suurimaid kaustu."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkastele kaikkia sisäisiä ja ulkoisia asemia, niiden käyttöä ja kunkin taltion suurimmat kansiot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichez tous vos disques internes et externes, leur utilisation et les dossiers les plus volumineux sur chaque volume."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Féach ar do thiomáineann inmheánacha agus seachtracha go léir, ar a n-úsáid, agus ar na fillteáin is mó ar gach imleabhar."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी सभी आंतरिक और बाहरी ड्राइव, उनका उपयोग और प्रत्येक वॉल्यूम पर सबसे बड़े फ़ोल्डर देखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pogledajte sve svoje unutarnje i vanjske pogone, njihovu upotrebu i najveće mape na svakom volumenu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekintse meg az összes belső és külső meghajtót, azok használatát, valamint az egyes kötetek legnagyobb mappáit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualizza tutte le tue unità interne ed esterne, il loro utilizzo e le cartelle più grandi su ciascun volume."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての内部ドライブと外部ドライブ、その使用状況、および各ボリューム上の最大のフォルダーを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 내부 및 외부 드라이브, 사용량, 각 볼륨의 가장 큰 폴더를 확인하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peržiūrėkite visus vidinius ir išorinius diskus, jų naudojimą ir didžiausius kiekvieno tomo aplankus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skatiet visus savus iekšējos un ārējos diskus, to lietojumu un lielākās mapes katrā sējumā."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ara d-drajvs interni u esterni tiegħek kollha, l-użu tagħhom, u l-akbar folders fuq kull volum."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk al uw interne en externe schijven, hun gebruik en de grootste mappen op elk volume."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetl wszystkie dyski wewnętrzne i zewnętrzne, ich wykorzystanie oraz największe foldery na każdym woluminie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja todas as suas unidades internas e externas, seu uso e as maiores pastas em cada volume."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
