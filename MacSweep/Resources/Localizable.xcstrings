    "Successfully moved %@ and its data (%@) to external drive.\nSymbolic links were created — %@ will work normally from the external drive." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ и неговите данни (%@) бяха успешно преместени на външно устройство.\nБяха създадени символни връзки — %@ ще работи нормално от външното устройство."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a jeho data (%@) byly úspěšně přesunuty na externí disk.\nByly vytvořeny symbolické odkazy — %@ bude fungovat normálně z externího disku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyttet %@ og dets data (%@) til eksternt drev.\nSymbolske links blev oprettet — %@ fungerer normalt fra det eksterne drev."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ und seine Daten (%@) erfolgreich auf ein externes Laufwerk verschoben.\nEs wurden symbolische Links erstellt – %@ funktioniert normal vom externen Laufwerk aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ και τα δεδομένα του (%@) μετακινήθηκαν με επιτυχία σε εξωτερική μονάδα δίσκου.\nΔημιουργήθηκαν συμβολικοί σύνδεσμοι — Το %@ θα λειτουργεί κανονικά από την εξωτερική μονάδα δίσκου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Successfully moved %1$@ and its data (%2$@) to external drive.\nSymbolic links were created — %3$@ will work normally from the external drive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se movió exitosamente %@ y sus datos (%@) a una unidad externa.\nSe crearon enlaces simbólicos: %@ funcionará normalmente desde el disco externo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ja selle andmed (%@) teisaldati edukalt välisele draivile.\nLoodi sümboolsed lingid — %@ töötab välisest draivist normaalselt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ja sen tiedot (%@) siirrettiin onnistuneesti ulkoiseen asemaan.\nSymboliset linkit luotiin — %@ toimii normaalisti ulkoisesta asemasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacement réussi de %@ et de ses données (%@) vers un disque externe.\nDes liens symboliques ont été créés — %@ fonctionnera normalement à partir du disque externe."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D'éirigh le bogadh %@ agus a chuid sonraí (%@) chuig tiomáint seachtrach.\nCruthaíodh naisc siombalacha — oibreoidh %@ de ghnáth ón tiomántán seachtrach."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ और उसके डेटा (%@) को बाहरी ड्राइव पर सफलतापूर्वक ले जाया गया।\nप्रतीकात्मक लिंक बनाए गए - %@ बाहरी ड्राइव से सामान्य रूप से काम करेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ i njegovi podaci (%@) uspješno su premješteni na vanjski pogon.\nStvorene su simboličke veze — %@ će normalno raditi s vanjskog pogona."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %@ és adatai (%@) sikeresen áthelyezve a külső meghajtóra.\nSzimbolikus hivatkozások jöttek létre — a %@ normálisan fog működni a külső meghajtóról."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spostamento di %@ e dei relativi dati (%@) su un'unità esterna completata.\nSono stati creati collegamenti simbolici: %@ funzionerà normalmente dall'unità esterna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ とそのデータ (%@) を外部ドライブに正常に移動しました。\nシンボリック リンクが作成されました — %@ は外部ドライブから正常に動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 및 해당 데이터(%@)를 외부 드라이브로 성공적으로 이동했습니다.\n심볼릭 링크가 생성되었습니다. %@는 외부 드라이브에서 정상적으로 작동합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ir jo duomenys (%@) sėkmingai perkelti į išorinį diską.\nSukurtos simbolinės nuorodos – %@ iš išorinio disko veiks normaliai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ un tā dati (%@) veiksmīgi pārvietoti uz ārējo disku.\nTika izveidotas simboliskas saites — %@ darbosies normāli no ārējā diska."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imċaqlaq b'suċċess %@ u d-dejta tiegħu (%@) għal drive estern.\nInħolqu links simboliċi — %@ jaħdem b'mod normali mid-drajv estern."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ en de bijbehorende gegevens (%@) zijn succesvol verplaatst naar een externe schijf.\nEr zijn symbolische koppelingen gemaakt: %@ werkt normaal vanaf de externe schijf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomyślnie przeniesiono %@ i jego dane (%@) na dysk zewnętrzny.\nUtworzono dowiązania symboliczne — %@ będzie działać normalnie z dysku zewnętrznego."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e seus dados (%@) movidos com sucesso para uma unidade externa.\nLinks simbólicos foram criados — %@ funcionará normalmente no drive externo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e seus dados (%@) movidos com sucesso para uma unidade externa.\nLinks simbólicos foram criados — %@ funcionará normalmente no drive externo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S-au mutat cu succes %@ și datele sale (%@) pe unitatea externă.\nAu fost create legături simbolice — %@ va funcționa normal de pe unitatea externă."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ සහ එහි දත්ත (%@) බාහිර ධාවකය වෙත සාර්ථකව ගෙන යන ලදී.\nසංකේතාත්මක සබැඳි සාදන ලදී - %@ බාහිර ධාවකයෙන් සාමාන්‍යයෙන් ක්‍රියා කරයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a jeho údaje (%@) boli úspešne presunuté na externý disk.\nBoli vytvorené symbolické prepojenia — %@ bude fungovať normálne z externého disku."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in njegovi podatki (%@) uspešno premaknjeni na zunanji pogon.\nUstvarile so se simbolne povezave — %@ bo normalno deloval z zunanjega diska."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyttade %@ och dess data (%@) till extern enhet.\nSymboliska länkar skapades — %@ fungerar normalt från den externa enheten."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ மற்றும் அதன் தரவு (%@) வெளிப்புற இயக்ககத்திற்கு வெற்றிகரமாக நகர்த்தப்பட்டது.\nகுறியீட்டு இணைப்புகள் உருவாக்கப்பட்டன - %@ வெளிப்புற இயக்ககத்திலிருந்து சாதாரணமாக வேலை செய்யும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已成功将 %@ 及其数据 (%@) 移动到外部驱动器。\n符号链接已创建 - %@ 将在外部驱动器上正常工作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已成功將 %@ 及其資料 (%@) 移至外部磁碟機。\n符號連結已建立 - %@ 將在外部磁碟機上正常運作。"
          }
        }
      }
    },
