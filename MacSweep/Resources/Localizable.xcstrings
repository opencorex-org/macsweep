    "View all your internal and external drives, their usage, and the largest folders on each volume." : {
      "extractionState" : "stale",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вижте всичките си вътрешни и външни устройства, тяхното използване и най-големите папки на всеки том."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
