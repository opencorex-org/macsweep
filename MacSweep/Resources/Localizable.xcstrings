    "Scan Desktop, Documents, Downloads, Movies, Music, and Pictures for files above your chosen size." : {
      "extractionState" : "stale",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сканирайте работен плот, документи, файлове за изтегляне, филми, музика и снимки за файлове над избрания от вас размер."
