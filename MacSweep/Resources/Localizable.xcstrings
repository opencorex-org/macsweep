    "Choose what MacSweep may clean. No files are removed until you approve." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете какво може да почиства MacSweep. Никакви файлове не се премахват, докато не одобрите."
