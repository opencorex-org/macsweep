    "Inspect system caches, logs, Trash, and supported developer-tool caches in one comprehensive scan." : {
      "extractionState" : "stale",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверете системните кешове, регистрационни файлове, кошчето и поддържаните кешове на инструменти за разработчици в едно цялостно сканиране."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prohlédněte systémové mezipaměti, protokoly, koš a mezipaměti podporovaných vývojářských nástrojů v rámci jednoho komplexního skenování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undersøg systemcaches, logfiler, papirkurven og understøttede udviklerværktøjscacher i én omfattende scanning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfen Sie Systemcaches, Protokolle, Papierkorb und unterstützte Entwicklertool-Caches in einem umfassenden Scan."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιθεωρήστε τις κρυφές μνήμες, τα αρχεία καταγραφής, τον Κάδο απορριμμάτων και τις υποστηριζόμενες κρυφές μνήμες εργαλείων προγραμματιστή σε μία ολοκληρωμένη σάρωση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspect system caches, logs, Trash, and supported developer-tool caches in one comprehensive scan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspeccione las cachés del sistema, los registros, la papelera y las cachés de herramientas de desarrollador compatibles en un análisis completo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollige süsteemi vahemälu, logisid, prügikasti ja toetatud arendajatööriistade vahemälu ühe põhjaliku skannimisega."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista järjestelmän välimuistit, lokit, roskakori ja tuetut kehittäjätyökalujen välimuistit yhdellä kattavalla tarkistuksella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspectez les caches système, les journaux, la corbeille et les caches des outils de développement pris en charge en une seule analyse complète."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniúchadh a dhéanamh ar thaiscí córais, logaí, Bruscar, agus taisce forbróra-uirlis tacaithe in aon scanadh cuimsitheach amháin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक व्यापक स्कैन में सिस्टम कैश, लॉग, ट्रैश और समर्थित डेवलपर-टूल कैश का निरीक्षण करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregledajte predmemorije sustava, zapisnike, smeće i podržane predmemorije alata za razvojne programere u jednom sveobuhvatnom skeniranju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vizsgálja meg a rendszer gyorsítótárait, naplóit, a kukát és a támogatott fejlesztői eszköz gyorsítótárait egyetlen átfogó vizsgálatban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ispeziona cache di sistema, registri, Cestino e cache degli strumenti di sviluppo supportati in un'unica scansione completa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム キャッシュ、ログ、ゴミ箱、サポートされている開発者ツール キャッシュを 1 回の包括的なスキャンで検査します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번의 포괄적인 검사로 시스템 캐시, 로그, 휴지통 및 지원되는 개발자 도구 캐시를 검사합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vienu išsamiu nuskaitymu patikrinkite sistemos talpyklas, žurnalus, šiukšliadėžę ir palaikomas kūrėjo įrankio talpyklas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārbaudiet sistēmas kešatmiņas, žurnālus, atkritni un atbalstītās izstrādātāja rīku kešatmiņas vienā visaptverošā skenēšanas reizē."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spezzjona l-caches tas-sistema, zkuk, Trash, u caches tal-għodda tal-iżviluppatur appoġġjati fi skan wieħed komprensiv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspecteer systeemcaches, logboeken, prullenbak en ondersteunde caches van ontwikkelaarstools in één uitgebreide scan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź pamięć podręczną systemu, dzienniki, kosz i obsługiwane pamięci podręczne narzędzi programistycznych podczas jednego kompleksowego skanowania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspecione caches do sistema, logs, Lixeira e caches de ferramentas de desenvolvedor compatíveis em uma verificação abrangente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspecione caches do sistema, logs, Lixeira e caches de ferramentas de desenvolvedor compatíveis em uma verificação abrangente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspectați memoria cache de sistem, jurnalele, Coșul de gunoi și cache-urile instrumentelor de dezvoltator acceptate într-o singură scanare completă."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "එක් විස්තීර්ණ ස්කෑන් එකකින් පද්ධති හැඹිලි, ලොග, කුණු කූඩය සහ සහය දක්වන සංවර්ධක මෙවලම් හැඹිලි පරීක්ෂා කරන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skontrolujte systémové vyrovnávacie pamäte, protokoly, kôš a vyrovnávacie pamäte podporovaných vývojárskych nástrojov v rámci jedného komplexného skenovania."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preglejte sistemske predpomnilnike, dnevnike, smetnjak in podprte predpomnilnike orodij za razvijalce v enem obsežnem pregledu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspektera systemcachar, loggar, papperskorgen och cacher som stöds av utvecklarverktyg i en omfattande genomsökning."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒரு விரிவான ஸ்கேன் மூலம் கணினி தற்காலிக சேமிப்புகள், பதிவுகள், குப்பைகள் மற்றும் ஆதரிக்கப்படும் டெவலப்பர்-கருவி தற்காலிக சேமிப்புகளை ஆய்வு செய்யவும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过一次全面扫描检查系统缓存、日志、垃圾箱和支持的开发人员工具缓存。"
