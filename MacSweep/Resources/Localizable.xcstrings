    "Permanently removed %@ from %lld developer items." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Премахнато за постоянно %@ от %lld елементи за разработчици."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trvale odstraněno %@ z položek vývojáře %lld."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjernet %@ permanent fra %lld udviklerelementer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dauerhaft aus %lld-Entwicklerelementen entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καταργήθηκε οριστικά το %@ από τα στοιχεία προγραμματιστή %lld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Permanently removed %1$@ from %2$lld developer items."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminó permanentemente %@ de los elementos de desarrollador %lld."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ eemaldati jäädavalt arendusüksustest %lld."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ poistettu pysyvästi %lld-kehittäjäkohteista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ supprimé définitivement des éléments de développement %lld."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a bhaint de mhíreanna forbróra %lld go buan."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld डेवलपर आइटम से %@ को स्थायी रूप से हटा दिया गया।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je trajno uklonjen iz %lld stavki razvojnog programera."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ véglegesen eltávolítva a %lld fejlesztői elemek közül."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimosso definitivamente %@ dagli elementi sviluppatore %lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 開発者アイテムから %@ を完全に削除しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 개발자 항목에서 %@가 영구적으로 제거되었습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ visam laikui pašalintas iš %lld kūrėjo elementų."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ neatgriezeniski noņemts no %lld izstrādātāja vienumiem."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tneħħa b'mod permanenti mill-oġġetti tal-iżviluppatur %lld."
          }
        },
