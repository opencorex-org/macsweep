        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacSweep potřebuje před odinstalací úplný přístup k disku, aby mohl přesunout aplikaci a její chráněné kontejnery dohromady, aniž by došlo k částečnému odinstalování."
