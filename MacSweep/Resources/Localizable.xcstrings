    "Scanning calculates full app bundle and associated data folder sizes. Results stream live." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сканирането изчислява пълния пакет с приложения и свързаните размери на папка с данни. Резултати поточно предаване на живо."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skenování vypočítá celý balíček aplikací a související velikosti datových složek. Živý přenos výsledků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanning beregner fuld app-pakke og tilhørende datamappestørrelser. Resultater streames live."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch das Scannen werden das gesamte App-Bundle und die zugehörigen Datenordnergrößen berechnet. Live-Übertragung der Ergebnisse."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σάρωση υπολογίζει το πλήρες πακέτο εφαρμογών και τα σχετικά μεγέθη φακέλων δεδομένων. Τα αποτελέσματα μεταδίδονται ζωντανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanning calculates full app bundle and associated data folder sizes. Results stream live."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El escaneo calcula el paquete completo de aplicaciones y los tamaños de las carpetas de datos asociadas. Los resultados se transmiten en vivo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skannimine arvutab rakenduse kogumi ja sellega seotud andmekaustade suuruse. Tulemuste otseülekanne."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skannaus laskee koko sovelluspaketin ja siihen liittyvien tietokansioiden koot. Tulokset suoratoistaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'analyse calcule l'ensemble d'applications complet et la taille des dossiers de données associés. Les résultats sont diffusés en direct."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ríomhann an scanadh cuachta app iomlán agus méideanna fillteán sonraí gaolmhara. Torthaí sruth beo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्कैनिंग पूर्ण ऐप बंडल और संबंधित डेटा फ़ोल्डर आकार की गणना करती है। परिणाम लाइव स्ट्रीम करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skeniranjem se izračunava puni app bundle i veličina mape povezanih podataka. Prijenos rezultata uživo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szkennelés kiszámítja a teljes alkalmazáscsomagot és a kapcsolódó adatmappák méretét. Az eredmények élő közvetítése."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scansione calcola l'intero pacchetto di app e le dimensioni della cartella dati associata. I risultati vengono trasmessi in diretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャンすると、完全なアプリ バンドルと関連するデータ フォルダーのサイズが計算されます。結果はライブでストリーミングされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스캔하면 전체 앱 번들 및 관련 데이터 폴더 크기가 계산됩니다. 결과는 실시간으로 스트리밍됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuskaitymas apskaičiuoja visą programos paketą ir susijusių duomenų aplankų dydžius. Rezultatai tiesiogiai transliuojami."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skenēšana aprēķina visu lietotņu komplektu un saistīto datu mapju izmērus. Rezultātu straume tiešraidē."
          }
        },
        "mt" : {
          "stringUnit" : {
