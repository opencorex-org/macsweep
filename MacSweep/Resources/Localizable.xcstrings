    "Optimize system performance, clean junk files, analyze disk usage, and manage developer caches." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оптимизирайте производителността на системата, изчистете нежеланите файлове, анализирайте използването на диска и управлявайте кешовете на разработчиците."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimalizujte výkon systému, čistěte nevyžádané soubory, analyzujte využití disku a spravujte mezipaměti pro vývojáře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimer systemets ydeevne, rens uønskede filer, analyser diskbrug og administrer udviklercaches."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimieren Sie die Systemleistung, bereinigen Sie Junk-Dateien, analysieren Sie die Festplattennutzung und verwalten Sie Entwickler-Caches."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βελτιστοποιήστε την απόδοση του συστήματος, καθαρίστε ανεπιθύμητα αρχεία, αναλύστε τη χρήση του δίσκου και διαχειριστείτε τις κρυφές μνήμες προγραμματιστών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimize system performance, clean junk files, analyze disk usage, and manage developer caches."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimice el rendimiento del sistema, limpie archivos basura, analice el uso del disco y administre las cachés de los desarrolladores."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimeerige süsteemi jõudlust, puhastage rämpsfaile, analüüsige kettakasutust ja hallake arendaja vahemälu."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimoi järjestelmän suorituskyky, puhdista turhat tiedostot, analysoi levyn käyttöä ja hallitse kehittäjien välimuistia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimisez les performances du système, nettoyez les fichiers inutiles, analysez l'utilisation du disque et gérez les caches des développeurs."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feidhmíocht an chórais a bharrfheabhsú, dramhchomhaid a ghlanadh, anailís a dhéanamh ar úsáid dioscaí, agus bainistigh taisce forbróra."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम प्रदर्शन को अनुकूलित करें, जंक फ़ाइलों को साफ़ करें, डिस्क उपयोग का विश्लेषण करें और डेवलपर कैश प्रबंधित करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimizirajte performanse sustava, očistite neželjene datoteke, analizirajte korištenje diska i upravljajte predmemorijama programera."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimalizálja a rendszer teljesítményét, tisztítsa meg a kéretlen fájlokat, elemezze a lemezhasználatot és kezelje a fejlesztői gyorsítótárakat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ottimizza le prestazioni del sistema, pulisci i file spazzatura, analizza l'utilizzo del disco e gestisci le cache degli sviluppatori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムのパフォーマンスを最適化し、ジャンク ファイルをクリーンアップし、ディスク使用量を分析し、開発者キャッシュを管理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 성능을 최적화하고, 정크 파일을 정리하고, 디스크 사용량을 분석하고, 개발자 캐시를 관리합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimizuokite sistemos našumą, išvalykite nepageidaujamus failus, analizuokite disko naudojimą ir tvarkykite kūrėjo talpyklas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimizējiet sistēmas veiktspēju, notīriet nevēlamos failus, analizējiet diska lietojumu un pārvaldiet izstrādātāju kešatmiņu."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ottimizza l-prestazzjoni tas-sistema, naddaf fajls junk, tanalizza l-użu tad-disk, u mmaniġġja l-caches tal-iżviluppatur."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimaliseer de systeemprestaties, ruim ongewenste bestanden op, analyseer het schijfgebruik en beheer de caches van ontwikkelaars."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optymalizuj wydajność systemu, usuwaj niepotrzebne pliki, analizuj użycie dysku i zarządzaj pamięcią podręczną programistów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otimize o desempenho do sistema, limpe arquivos indesejados, analise o uso do disco e gerencie caches de desenvolvedores."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otimize o desempenho do sistema, limpe arquivos indesejados, analise o uso do disco e gerencie caches de desenvolvedores."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimizați performanța sistemului, curățați fișierele nedorite, analizați utilizarea discului și gestionați memoria cache pentru dezvoltatori."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "පද්ධති ක්‍රියාකාරිත්වය ප්‍රශස්ත කරන්න, කුණු ගොනු පිරිසිදු කරන්න, තැටි භාවිතය විශ්ලේෂණය කරන්න, සහ සංවර්ධක හැඹිලි කළමනාකරණය කරන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimalizujte výkon systému, čistite nevyžiadané súbory, analyzujte využitie disku a spravujte vyrovnávaciu pamäť vývojárov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimizirajte delovanje sistema, očistite neželene datoteke, analizirajte uporabo diska in upravljajte predpomnilnike za razvijalce."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimera systemprestanda, rensa skräpfiler, analysera diskanvändning och hantera utvecklarcacher."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கணினி செயல்திறனை மேம்படுத்தவும், குப்பைக் கோப்புகளை சுத்தம் செய்யவும், வட்டு பயன்பாட்டை பகுப்பாய்வு செய்யவும் மற்றும் டெவலப்பர் தற்காலிக சேமிப்புகளை நிர்வகிக்கவும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优化系统性能、清理垃圾文件、分析磁盘使用情况以及管理开发人员缓存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優化系統效能、清理垃圾檔案、分析磁碟使用以及管理開發人員快取。"
          }
        }
      }
    },
