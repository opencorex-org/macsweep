    "All components above will be moved to external storage and symlinked transparently." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всички компоненти по-горе ще бъдат преместени във външно хранилище и ще бъдат свързани прозрачно."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny výše uvedené komponenty budou přesunuty do externího úložiště a budou transparentně označeny symboly."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle komponenter ovenfor vil blive flyttet til eksternt lager og symlinket gennemsigtigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle oben genannten Komponenten werden in den externen Speicher verschoben und transparent symbolisch verknüpft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα τα παραπάνω στοιχεία θα μετακινηθούν σε εξωτερικό χώρο αποθήκευσης και θα συνδεθούν με διαφάνεια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All components above will be moved to external storage and symlinked transparently."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los componentes anteriores se moverán al almacenamiento externo y se vincularán simbólicamente de forma transparente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kõik ülaltoodud komponendid teisaldatakse välismällu ja lingitakse läbipaistvalt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki yllä olevat komponentit siirretään ulkoiseen tallennustilaan ja linkitetään läpinäkyvästi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les composants ci-dessus seront déplacés vers un stockage externe et liés de manière transparente."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aistreofar na comhpháirteanna go léir thuas chuig stóráil sheachtrach agus déanfar iad a shimplí go trédhearcach."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपरोक्त सभी घटकों को बाहरी भंडारण में ले जाया जाएगा और पारदर्शी रूप से सिम्लिंक किया जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sve gore navedene komponente bit će premještene u vanjsku pohranu i transparentno simbolično povezane."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az összes fenti összetevő külső tárhelyre kerül, és átlátszóan szimbolizálva lesz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i componenti di cui sopra verranno spostati nella memoria esterna e collegati simbolicamente in modo trasparente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上記のすべてのコンポーネントは外部ストレージに移動され、透過的にシンボリックリンクされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위의 모든 구성 요소는 외부 저장소로 이동되고 투명하게 심볼릭 연결됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visi anksčiau pateikti komponentai bus perkelti į išorinę saugyklą ir skaidriai susieti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visi iepriekš minētie komponenti tiks pārvietoti uz ārējo krātuvi un ar simbolisku saiti tiks pārskatāmi."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-komponenti kollha t'hawn fuq se jiġu mċaqalqa għal ħażna esterna u symlinked b'mod trasparenti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle bovenstaande componenten worden naar externe opslag verplaatst en transparant gesymlinkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie powyższe komponenty zostaną przeniesione do pamięci zewnętrznej i dowiązane symbolicznie w przezroczysty sposób."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os componentes acima serão movidos para armazenamento externo e vinculados de forma transparente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os componentes acima serão movidos para armazenamento externo e vinculados de forma transparente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toate componentele de mai sus vor fi mutate în spațiul de stocare extern și vor fi legate transparent."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඉහත සියලුම සංරචක බාහිර ආචයනය වෙත ගෙන යන අතර විනිවිද පෙනෙන ලෙස සම්බන්ධ කරනු ලැබේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetky vyššie uvedené komponenty sa presunú do externého úložiska a budú transparentne označené symbolom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vse zgornje komponente bodo premaknjene v zunanji pomnilnik in transparentno povezane s simboli."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla komponenter ovan kommer att flyttas till extern lagring och symlinkas transparent."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மேலே உள்ள அனைத்து கூறுகளும் வெளிப்புற சேமிப்பகத்திற்கு நகர்த்தப்பட்டு வெளிப்படையான முறையில் இணைக்கப்படும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上述所有组件都将被移动到外部存储并透明地进行符号链接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上述所有組件都將被移動到外部儲存並透明地進行符號連結。"
          }
        }
      }
    },
