    "MacSweep" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacSweep"
          }
        }
      }
    },
    "MacSweep needs to restart to apply the new language. Your work will not be lost." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج MacSweep إلى إعادة التشغيل لتطبيق اللغة الجديدة. لن يضيع عملك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নতুন ভাষা প্রয়োগ করতে MacSweep পুনরায় চালু করতে হবে। আপনার কাজ হারিয়ে যাবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacSweep muss neu gestartet werden, um die neue Sprache anzuwenden. Ihre Arbeit geht nicht verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacSweep needs to restart to apply the new language. Your work will not be lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacSweep necesita reiniciarse para aplicar el nuevo idioma. Su trabajo no se perderá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacSweep doit redémarrer pour appliquer la nouvelle langue. Votre travail ne sera pas perdu."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "નવી ભાષા લાગુ કરવા MacSweep ને પુનઃપ્રારંભ કરવું આવશ્યક છે. તમારું કાર્ય ખોવાઈ જશે નહીં."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नई भाषा लागू करने के लिए MacSweep को पुनः आरंभ करना होगा। आपका काम खोएगा नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacSweep deve riavviarsi per applicare la nuova lingua. Il tuo lavoro non andrà perso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい言語を適用するにはMacSweepを再起動する必要があります。作業内容は失われません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಹೊಸ ಭಾಷೆಯನ್ನು ಅನ್ವಯಿಸಲು MacSweep ಮರುಪ್ರಾರಂಭಗೊಳ್ಳಬೇಕು. ನಿಮ್ಮ ಕೆಲಸ ಕಳೆದುಹೋಗುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 언어를 적용하려면 MacSweep을 재시작해야 합니다. 작업 내용은 손실되지 않습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പുതിയ ഭാഷ പ്രയോഗിക്കാൻ MacSweep പുനരാരംഭിക്കേണ്ടതുണ്ട്. നിങ്ങളുടെ ജോലി നഷ്ടപ്പെടില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नवीन भाषा लागू करण्यासाठी MacSweep पुन्हा सुरू करणे आवश्यक आहे. तुमचे काम गमावले जाणार नाही."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacSweep moet opnieuw worden opgestart om de nieuwe taal toe te passen. Uw werk gaat niet verloren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacSweep musi zostać uruchomiony ponownie, aby zastosować nowy język. Twoja praca nie zostanie utracona."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MacSweep precisa ser reiniciado para aplicar o novo idioma. Seu trabalho não será perdido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacSweep необходимо перезапустить для применения нового языка. Ваша работа не будет потеряна."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "නව භාෂාව යෙදීමට MacSweep නැවත ආරම්භ කළ යුතුය. ඔබේ කාර්යය නැති නොවේ."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "புதிய மொழியைப் பயன்படுத்த MacSweep மறுதொடக்கம் செய்ய வேண்டும். உங்கள் பணி இழக்கப்படாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కొత్త భాషను వర్తించడానికి MacSweep పునఃప్రారంభించాలి. మీ పని కోల్పోదు."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacSweep 需要重启以应用新语言。您的工作不会丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacSweep 需要重新啟動以套用新語言。您的工作不會遺失。"
          }
        }
      }
    },
