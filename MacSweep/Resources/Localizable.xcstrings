        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் உள் மற்றும் வெளிப்புற இயக்கிகள், அவற்றின் பயன்பாடு மற்றும் ஒவ்வொரு தொகுதியிலும் உள்ள மிகப்பெரிய கோப்புறைகள் ஆகியவற்றைப் பார்க்கலாம்."
          }
