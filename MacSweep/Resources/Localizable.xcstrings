    "To clean system caches, user logs, and developer artifacts, MacSweep needs Full Disk Access permission." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За да изчисти системните кешове, потребителските регистрационни файлове и артефактите на разработчиците, MacSweep се нуждае от разрешение за пълен достъп до диска."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K čištění mezipaměti systému, uživatelských protokolů a vývojářských artefaktů potřebuje MacSweep oprávnění Full Disk Access."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at rense systemcaches, brugerlogfiler og udviklerartefakter skal MacSweep have fuld diskadgang-tilladelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Systemcaches, Benutzerprotokolle und Entwicklerartefakte zu bereinigen, benötigt MacSweep die Berechtigung „Vollständiger Festplattenzugriff“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να καθαρίσει τις κρυφές μνήμες του συστήματος, τα αρχεία καταγραφής χρηστών και τα τεχνουργήματα προγραμματιστή, το MacSweep χρειάζεται άδεια πλήρους πρόσβασης στο δίσκο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To clean system caches, user logs, and developer artifacts, MacSweep needs Full Disk Access permission."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para limpiar cachés del sistema, registros de usuarios y artefactos de desarrollador, MacSweep necesita permiso de acceso total al disco."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Süsteemi vahemälu, kasutajalogide ja arendaja artefaktide puhastamiseks vajab MacSweep täielikku kettale juurdepääsu luba."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järjestelmän välimuistien, käyttäjälokien ja kehittäjien artefaktien puhdistamiseen MacSweep tarvitsee täyden levyn käyttöoikeuden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour nettoyer les caches système, les journaux utilisateur et les artefacts de développeur, MacSweep a besoin d'une autorisation d'accès complet au disque."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chun taisce córais, logaí úsáideoirí, agus déantáin fhorbróra a ghlanadh, tá cead Rochtana Iomlán Diosca ag teastáil ó MacSweep."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम कैश, उपयोगकर्ता लॉग और डेवलपर कलाकृतियों को साफ़ करने के लिए, मैकस्वीप को पूर्ण डिस्क एक्सेस अनुमति की आवश्यकता होती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za čišćenje sistemskih predmemorija, korisničkih zapisa i artefakata programera, MacSweep treba dozvolu punog pristupa disku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rendszer gyorsítótárak, felhasználói naplók és fejlesztői melléktermékek tisztításához a MacSweepnek teljes lemezhozzáférési engedélyre van szüksége."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per pulire le cache di sistema, i registri degli utenti e gli artefatti degli sviluppatori, MacSweep necessita dell'autorizzazione di accesso completo al disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム キャッシュ、ユーザー ログ、および開発者アーティファクトをクリーンアップするには、MacSweat にフル ディスク アクセス許可が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 캐시, 사용자 로그 및 개발자 아티팩트를 정리하려면 MacSweep에 전체 디스크 액세스 권한이 필요합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Norint išvalyti sistemos talpyklas, vartotojų žurnalus ir kūrėjo artefaktus, „MacSweep“ reikia visos prieigos prie disko leidimo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lai notīrītu sistēmas kešatmiņu, lietotāju žurnālus un izstrādātāju artefaktus, MacSweep nepieciešama pilnas diska piekļuves atļauja."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biex tnaddaf il-caches tas-sistema, zkuk tal-utenti, u artifacts tal-iżviluppatur, MacSweep jeħtieġ permess Sħiħ għall-Aċċess għad-Disk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om systeemcaches, gebruikerslogboeken en ontwikkelaarsartefacten op te schonen, heeft MacSweep toestemming voor volledige schijftoegang nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby wyczyścić pamięć podręczną systemu, dzienniki użytkowników i artefakty programistów, MacSweep potrzebuje pozwolenia na pełny dostęp do dysku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para limpar caches do sistema, logs de usuários e artefatos de desenvolvedor, o MacSweep precisa de permissão de acesso total ao disco."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para limpar caches do sistema, logs de usuários e artefatos de desenvolvedor, o MacSweep precisa de permissão de acesso total ao disco."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru a curăța cache-urile de sistem, jurnalele utilizatorilor și artefactele dezvoltatorului, MacSweep are nevoie de permisiunea de acces complet la disc."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "පද්ධති හැඹිලි, පරිශීලක ලොග සහ සංවර්ධක පුරාවස්තු පිරිසිදු කිරීමට, MacSweep හට සම්පූර්ණ තැටි ප්‍රවේශ අවසරය අවශ්‍ය වේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na čistenie vyrovnávacej pamäte systému, denníkov používateľov a artefaktov vývojárov potrebuje MacSweep povolenie na úplný prístup k disku."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za čiščenje sistemskih predpomnilnikov, uporabniških dnevnikov in razvijalskih artefaktov MacSweep potrebuje dovoljenje za polni dostop do diska."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att rensa systemcachar, användarloggar och utvecklarartefakter behöver MacSweep behörighet för fullständig diskåtkomst."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கணினி தற்காலிக சேமிப்புகள், பயனர் பதிவுகள் மற்றும் டெவலப்பர் கலைப்பொருட்களை சுத்தம் செய்ய, MacSweep க்கு முழு வட்டு அணுகல் அனுமதி தேவை."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要清理系统缓存、用户日志和开发人员工件，MacSweep 需要完整磁盘访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要清理系統快取、使用者日誌和開發人員工件，MacSweep 需要完整磁碟存取權限。"
          }
        }
      }
    },
