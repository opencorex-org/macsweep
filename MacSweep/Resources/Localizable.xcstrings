    "Grant access before uninstalling protected application containers and support files." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предоставете достъп преди деинсталиране на защитени контейнери на приложения и поддържащи файлове."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Před odinstalováním chráněných kontejnerů aplikací a podpůrných souborů udělte přístup."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv adgang, før du afinstallerer beskyttede applikationscontainere og supportfiler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewähren Sie Zugriff, bevor Sie geschützte Anwendungscontainer und Supportdateien deinstallieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παραχωρήστε πρόσβαση πριν απεγκαταστήσετε προστατευμένα κοντέινερ εφαρμογών και αρχεία υποστήριξης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grant access before uninstalling protected application containers and support files."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conceda acceso antes de desinstalar contenedores de aplicaciones protegidas y archivos de soporte."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andke juurdepääs enne kaitstud rakenduste konteinerite ja tugifailide desinstallimist."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myönnä käyttöoikeus ennen suojattujen sovellussäilöjen ja tukitiedostojen asennuksen poistamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accordez l’accès avant de désinstaller les conteneurs d’applications protégés et les fichiers de support."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deonaigh rochtain sula ndíshuiteálann tú coimeádáin feidhmchláir chosanta agus comhaid tacaíochta."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संरक्षित एप्लिकेशन कंटेनर और समर्थन फ़ाइलों को अनइंस्टॉल करने से पहले पहुंच प्रदान करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odobrite pristup prije deinstaliranja zaštićenih spremnika aplikacija i datoteka podrške."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A védett alkalmazástárolók és támogatási fájlok eltávolítása előtt biztosítson hozzáférést."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concedere l'accesso prima di disinstallare i contenitori di applicazioni protette e i file di supporto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保護されたアプリケーション コンテナとサポート ファイルをアンインストールする前に、アクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보호된 애플리케이션 컨테이너 및 지원 파일을 제거하기 전에 액세스 권한을 부여하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suteikite prieigą prieš pašalindami apsaugotus programų konteinerius ir palaikymo failus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pirms aizsargāto lietojumprogrammu konteineru un atbalsta failu atinstalēšanas piešķiriet piekļuvi."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agħti aċċess qabel ma tneħħi kontenituri tal-applikazzjoni protetti u fajls ta' appoġġ."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verleen toegang voordat u beveiligde applicatiecontainers en ondersteuningsbestanden verwijdert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyznaj dostęp przed odinstalowaniem chronionych kontenerów aplikacji i plików pomocniczych."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conceda acesso antes de desinstalar contêineres de aplicativos protegidos e arquivos de suporte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conceda acesso antes de desinstalar contêineres de aplicativos protegidos e arquivos de suporte."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acordați acces înainte de a dezinstala containerele de aplicații protejate și fișierele de asistență."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ආරක්ෂිත යෙදුම් බහාලුම් සහ ආධාරක ගොනු අස්ථාපනය කිරීමට පෙර ප්‍රවේශය ලබා දෙන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pred odinštalovaním chránených kontajnerov aplikácií a podporných súborov udeľte prístup."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odobrite dostop pred odstranitvijo zaščitenih vsebnikov aplikacij in podpornih datotek."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevilja åtkomst innan du avinstallerar skyddade programbehållare och supportfiler."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பாதுகாக்கப்பட்ட பயன்பாட்டுக் கொள்கலன்கள் மற்றும் ஆதரவு கோப்புகளை நிறுவல் நீக்குவதற்கு முன் அணுகலை வழங்கவும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在卸载受保护的应用程序容器和支持文件之前授予访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在卸載受保護的應用程式容器和支援檔案之前授予存取權限。"
          }
        }
      }
