    "SIP integrity protected • System and critical files remain completely safe" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Защитена целостта на SIP • Системните и критичните файлове остават напълно безопасни"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ochrana integrity SIP • Systém a důležité soubory zůstávají zcela v bezpečí"
          }
        },
        "da" : {
          "stringUnit" : {
