    "Sponsorship is completely optional and does not unlock or restrict features." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спонсорството е напълно незадължително и не отключва или ограничава функциите."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sponzorství je zcela volitelné a neodemyká ani neomezuje funkce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sponsorat er helt valgfrit og låser ikke op eller begrænser funktioner."
