    "Without access, macOS may skip protected folders and results can be incomplete." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без достъп macOS може да пропусне защитени папки и резултатите може да са непълни."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez přístupu může macOS přeskočit chráněné složky a výsledky mohou být neúplné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uden adgang kan macOS springe beskyttede mapper over, og resultaterne kan være ufuldstændige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Zugriff überspringt macOS möglicherweise geschützte Ordner und die Ergebnisse können unvollständig sein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς πρόσβαση, το macOS μπορεί να παραλείψει προστατευμένους φακέλους και τα αποτελέσματα μπορεί να είναι ελλιπή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without access, macOS may skip protected folders and results can be incomplete."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin acceso, macOS puede omitir carpetas protegidas y los resultados pueden estar incompletos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilma juurdepääsuta võib macOS kaitstud kaustu vahele jätta ja tulemused võivad olla mittetäielikud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilman pääsyä macOS voi ohittaa suojatut kansiot ja tulokset voivat olla epätäydellisiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans accès, macOS peut ignorer les dossiers protégés et les résultats peuvent être incomplets."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gan rochtain, féadfaidh macOS fillteáin chosanta a scipeáil agus is féidir leis na torthaí a bheith neamhiomlán."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक्सेस के बिना, macOS संरक्षित फ़ोल्डर्स को छोड़ सकता है और परिणाम अधूरे हो सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez pristupa, macOS može preskočiti zaštićene mape i rezultati mogu biti nepotpuni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hozzáférés nélkül a macOS kihagyhatja a védett mappákat, és az eredmények hiányosak lehetnek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza accesso, macOS potrebbe saltare le cartelle protette e i risultati potrebbero essere incompleti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセスがないと、macOS は保護されたフォルダーをスキップし、結果が不完全になる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "액세스하지 않으면 macOS가 보호된 폴더를 건너뛸 수 있으며 결과가 불완전할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be prieigos „macOS“ gali praleisti apsaugotus aplankus, o rezultatai gali būti neišsamūs."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez piekļuves MacOS var izlaist aizsargātās mapes un rezultāti var būt nepilnīgi."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mingħajr aċċess, macOS jista 'jaqbeż folders protetti u r-riżultati jistgħu ma jkunux kompluti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder toegang kan macOS beveiligde mappen overslaan en kunnen de resultaten onvolledig zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez dostępu system macOS może pomijać chronione foldery, a wyniki mogą być niekompletne."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem acesso, o macOS pode pular pastas protegidas e os resultados podem ficar incompletos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem acesso, o macOS pode pular pastas protegidas e os resultados podem ficar incompletos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fără acces, macOS poate sări peste folderele protejate, iar rezultatele pot fi incomplete."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ප්‍රවේශය නොමැතිව, macOS ආරක්ෂිත ෆෝල්ඩර මඟ හැරිය හැකි අතර ප්‍රතිඵල අසම්පූර්ණ විය හැක."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez prístupu môže macOS preskočiť chránené priečinky a výsledky môžu byť neúplné."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brez dostopa lahko macOS preskoči zaščitene mape in rezultati so lahko nepopolni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utan åtkomst kan macOS hoppa över skyddade mappar och resultaten kan vara ofullständiga."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அணுகல் இல்லாமல், macOS பாதுகாக்கப்பட்ட கோப்புறைகளைத் தவிர்க்கலாம் மற்றும் முடிவுகள் முழுமையடையாது."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果没有访问权限，macOS 可能会跳过受保护的文件夹，并且结果可能不完整。"
