    "This setting becomes the default threshold for future Large Files scans." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тази настройка се превръща в праг по подразбиране за бъдещи сканирания на големи файлове."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto nastavení se stane výchozím prahem pro budoucí prověřování velkých souborů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne indstilling bliver standardgrænsen for fremtidige scanninger af store filer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellung wird zum Standardschwellenwert für zukünftige Scans großer Dateien."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η ρύθμιση γίνεται το προεπιλεγμένο όριο για μελλοντικές σαρώσεις Μεγάλων Αρχείων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This setting becomes the default threshold for future Large Files scans."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta configuración se convierte en el umbral predeterminado para futuros análisis de archivos grandes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sellest sättest saab tulevaste suurte failide skannimise vaikelävi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tästä asetuksesta tulee oletuskynnys tuleville suurten tiedostojen skannauksille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce paramètre devient le seuil par défaut pour les futures analyses de fichiers volumineux."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is é an socrú seo ná an tairseach réamhshocraithe le haghaidh scanadh Comhaid Mhóra amach anseo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सेटिंग भविष्य में बड़ी फ़ाइलों के स्कैन के लिए डिफ़ॉल्ट सीमा बन जाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova postavka postaje zadani prag za buduća skeniranja velikih datoteka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a beállítás lesz az alapértelmezett küszöbérték a jövőbeni nagy fájlok vizsgálatához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa impostazione diventa la soglia predefinita per le future scansioni di file di grandi dimensioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この設定は、今後の大規模ファイル スキャンのデフォルトのしきい値になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정은 향후 대용량 파일 검사에 대한 기본 임계값이 됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šis nustatymas tampa numatytuoju būsimų didelių failų nuskaitymo slenksčiu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šis iestatījums kļūst par noklusējuma slieksni turpmākai lielo failu skenēšanai."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dan l-issettjar isir il-limitu default għal skanijiet futuri ta' Fajls Kbar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze instelling wordt de standaarddrempel voor toekomstige scans van grote bestanden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ustawienie staje się domyślnym progiem dla przyszłych skanowań dużych plików."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essa configuração se torna o limite padrão para futuras verificações de arquivos grandes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essa configuração se torna o limite padrão para futuras verificações de arquivos grandes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această setare devine pragul implicit pentru viitoarele scanări ale fișierelor mari."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මෙම සැකසුම අනාගත විශාල ගොනු පරිලෝකනය සඳහා පෙරනිමි සීමාව බවට පත්වේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto nastavenie sa stane predvoleným prahom pre budúce kontroly veľkých súborov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta nastavitev postane privzeti prag za prihodnja skeniranja velikih datotek."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här inställningen blir standardtröskeln för framtida skanningar av stora filer."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த அமைப்பு எதிர்கால பெரிய கோப்புகளை ஸ்கேன் செய்வதற்கான இயல்புநிலை வரம்பாக மாறும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设置将成为未来大文件扫描的默认阈值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此設定將成為未來大文件掃描的預設閾值。"
          }
        }
      }
    },
    "This will copy all components back from the external drive to their original internal locations and remove the symbolic links. Make sure you have enough internal storage first." : {
      "extractionState" : "stale",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това ще копира всички компоненти обратно от външното устройство в оригиналните им вътрешни местоположения и ще премахне символните връзки. Първо се уверете, че имате достатъчно вътрешна памет."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tím se zkopírují všechny součásti zpět z externího disku na jejich původní vnitřní umístění a odstraní se symbolické odkazy. Nejprve se ujistěte, že máte dostatek vnitřního úložiště."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil kopiere alle komponenter tilbage fra det eksterne drev til deres oprindelige interne placeringer og fjerne de symbolske links. Sørg for, at du har nok intern lagerplads først."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle Komponenten vom externen Laufwerk an ihre ursprünglichen internen Speicherorte zurückkopiert und die symbolischen Links entfernt. Stellen Sie zunächst sicher, dass Sie über ausreichend internen Speicher verfügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό θα αντιγράψει όλα τα στοιχεία πίσω από την εξωτερική μονάδα δίσκου στις αρχικές εσωτερικές τους θέσεις και θα αφαιρέσει τους συμβολικούς συνδέσμους. Φροντίστε πρώτα να έχετε αρκετό εσωτερικό χώρο αποθήκευσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will copy all components back from the external drive to their original internal locations and remove the symbolic links. Make sure you have enough internal storage first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto copiará todos los componentes del disco externo a sus ubicaciones internas originales y eliminará los enlaces simbólicos. Primero asegúrese de tener suficiente almacenamiento interno."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See kopeerib kõik komponendid väliselt draivilt tagasi nende algsesse sisemisse asukohta ja eemaldab sümboolsed lingid. Esmalt veenduge, et teil oleks piisavalt sisemälu."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä kopioi kaikki komponentit takaisin ulkoisesta asemasta alkuperäisiin sisäisiin paikkoihinsa ja poistaa symboliset linkit. Varmista ensin, että sinulla on tarpeeksi sisäistä tallennustilaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela copiera tous les composants du disque externe vers leurs emplacements internes d'origine et supprimera les liens symboliques. Assurez-vous d’abord de disposer de suffisamment de stockage interne."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déanfaidh sé seo na comhpháirteanna go léir a chóipeáil ar ais ón tiomántán seachtrach chuig a láithreacha inmheánacha bunaidh agus bainfidh sé na naisc siombalacha. Déan cinnte go bhfuil go leor stórála inmheánach agat ar dtús."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सभी घटकों को बाहरी ड्राइव से उनके मूल आंतरिक स्थानों पर वापस कॉपी कर देगा और प्रतीकात्मक लिंक हटा देगा। पहले सुनिश्चित करें कि आपके पास पर्याप्त आंतरिक संग्रहण है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo će kopirati sve komponente natrag s vanjskog pogona na njihove izvorne interne lokacije i ukloniti simboličke veze. Prvo provjerite imate li dovoljno interne memorije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az összes összetevőt visszamásolja a külső meghajtóról az eredeti belső helyére, és eltávolítja a szimbolikus hivatkozásokat. Először győződjön meg arról, hogy elegendő belső tárhellyel rendelkezik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò copierà tutti i componenti dall'unità esterna alle loro posizioni interne originali e rimuoverà i collegamenti simbolici. Assicurati prima di avere abbastanza spazio di archiviazione interno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、すべてのコンポーネントが外部ドライブから元の内部の場所にコピーされ、シンボリック リンクが削除されます。最初に十分な内部ストレージがあることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이렇게 하면 모든 구성 요소가 외부 드라이브에서 원래 내부 위치로 다시 복사되고 기호 링크가 제거됩니다. 먼저 내부 저장 공간이 충분한지 확인하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taip visi komponentai bus nukopijuoti atgal iš išorinio disko į pradines vidines vietas ir pašalintos simbolinės nuorodos. Pirmiausia įsitikinkite, kad turite pakankamai vidinės atminties."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tādējādi visi komponenti tiks kopēti atpakaļ no ārējā diska to sākotnējās iekšējās vietās un noņemtas simboliskās saites. Vispirms pārliecinieties, vai jums ir pietiekami daudz iekšējās atmiņas."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dan se jikkopja l-komponenti kollha lura mid-drive esterna għall-postijiet interni oriġinali tagħhom u neħħi r-rabtiet simboliċi. Kun żgur li għandek biżżejjed ħażna interna l-ewwel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee worden alle componenten van de externe schijf teruggekopieerd naar hun oorspronkelijke interne locaties en worden de symbolische koppelingen verwijderd. Zorg eerst voor voldoende interne opslagruimte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to skopiowanie wszystkich komponentów z dysku zewnętrznego do ich oryginalnych lokalizacji wewnętrznych i usunięcie dowiązań symbolicznych. Najpierw upewnij się, że masz wystarczającą ilość pamięci wewnętrznej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso copiará todos os componentes da unidade externa para seus locais internos originais e removerá os links simbólicos. Certifique-se primeiro de ter armazenamento interno suficiente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso copiará todos os componentes da unidade externa para seus locais internos originais e removerá os links simbólicos. Certifique-se primeiro de ter armazenamento interno suficiente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest lucru va copia înapoi toate componentele de pe unitatea externă în locațiile lor interne originale și vor elimina legăturile simbolice. Asigurați-vă că aveți suficient spațiu de stocare intern."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මෙය සියලුම සංරචක බාහිර ධාවකයේ සිට ඒවායේ මුල් අභ්‍යන්තර ස්ථාන වෙත පිටපත් කර සංකේතාත්මක සබැඳි ඉවත් කරනු ඇත. ප්‍රථමයෙන් ඔබට ප්‍රමාණවත් අභ්‍යන්තර ආචයනයක් ඇති බවට වග බලා ගන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tým sa skopírujú všetky komponenty späť z externého disku na ich pôvodné interné miesta a odstránia sa symbolické odkazy. Najprv sa uistite, že máte dostatok internej pamäte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To bo kopiralo vse komponente nazaj z zunanjega pogona na njihove izvirne notranje lokacije in odstranilo simbolične povezave. Najprej se prepričajte, da imate dovolj notranjega pomnilnika."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta kommer att kopiera alla komponenter tillbaka från den externa enheten till sina ursprungliga interna platser och ta bort de symboliska länkarna. Se till att du har tillräckligt med intern lagring först."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இது வெளிப்புற இயக்ககத்திலிருந்து அனைத்து கூறுகளையும் அவற்றின் அசல் உள் இருப்பிடங்களுக்கு நகலெடுத்து குறியீட்டு இணைப்புகளை அகற்றும். உங்களிடம் போதுமான உள் சேமிப்பிடம் இருப்பதை முதலில் உறுதிசெய்யவும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会将所有组件从外部驱动器复制回其原始内部位置并删除符号链接。首先确保您有足够的内部存储空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會將所有元件從外部磁碟機複製回其原始內部位置並刪除符號連結。首先確保您有足夠的內部儲存空間。"
          }
        }
      }
    },
