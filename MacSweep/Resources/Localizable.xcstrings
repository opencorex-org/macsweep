        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ බාහිර ධාවකය වෙත ගෙන යන ලදී.\nසංකේතාත්මක සබැඳියක් සාදන ලදී - %@ සාමාන්යයෙන් වැඩ කරනු ඇත."
