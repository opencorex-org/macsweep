    "Protect your privacy by scanning and clearing web browser caches and local cookies." : {
      "extractionState" : "stale",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Защитете поверителността си, като сканирате и изчистите кешовете на уеб браузъра и локалните бисквитки."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chraňte své soukromí skenováním a vymazáním mezipaměti webového prohlížeče a místních souborů cookie."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskyt dit privatliv ved at scanne og rydde webbrowsercaches og lokale cookies."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schützen Sie Ihre Privatsphäre, indem Sie Webbrowser-Caches und lokale Cookies scannen und löschen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προστατέψτε το απόρρητό σας σαρώνοντας και εκκαθαρίζοντας τις κρυφές μνήμες του προγράμματος περιήγησης και τα τοπικά cookies."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protect your privacy by scanning and clearing web browser caches and local cookies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteja su privacidad escaneando y borrando las cachés del navegador web y las cookies locales."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaitske oma privaatsust, skannides ja tühjendades veebibrauseri vahemälu ja kohalikke küpsiseid."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suojaa yksityisyyttäsi skannaamalla ja tyhjentämällä verkkoselaimen välimuistit ja paikalliset evästeet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protégez votre vie privée en analysant et en effaçant les caches du navigateur Web et les cookies locaux."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosain do phríobháideachas trí thaisce brabhsálaí gréasáin agus fianáin áitiúla a scanadh agus a ghlanadh."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वेब ब्राउज़र कैश और स्थानीय कुकीज़ को स्कैन और साफ़ करके अपनी गोपनीयता को सुरक्षित रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaštitite svoju privatnost skeniranjem i brisanjem predmemorije web preglednika i lokalnih kolačića."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Védje magánéletét a webböngésző gyorsítótárának és a helyi cookie-k ellenőrzésével és törlésével."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteggi la tua privacy eseguendo la scansione e cancellando le cache del browser Web e i cookie locali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web ブラウザのキャッシュとローカル Cookie をスキャンしてクリアすることで、プライバシーを保護します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹 브라우저 캐시와 로컬 쿠키를 검사하고 삭제하여 개인 정보를 보호하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apsaugokite savo privatumą nuskaitydami ir išvalydami žiniatinklio naršyklės talpyklas ir vietinius slapukus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aizsargājiet savu privātumu, skenējot un notīrot tīmekļa pārlūkprogrammas kešatmiņu un lokālos sīkfailus."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipproteġi l-privatezza tiegħek billi tiskennja u tneħħi l-caches tal-web browser u l-cookies lokali."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bescherm uw privacy door de caches van webbrowsers en lokale cookies te scannen en te wissen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chroń swoją prywatność, skanując i czyszcząc pamięć podręczną przeglądarki internetowej oraz lokalne pliki cookie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteja sua privacidade verificando e limpando caches de navegadores e cookies locais."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteja sua privacidade verificando e limpando caches de navegadores e cookies locais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protejați-vă confidențialitatea scanând și ștergând memoria cache a browserului web și cookie-urile locale."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "වෙබ් බ්‍රවුසර හැඹිලි සහ දේශීය කුකීස් ස්කෑන් කිරීම සහ හිස් කිරීම මගින් ඔබේ පෞද්ගලිකත්වය ආරක්ෂා කරන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chráňte svoje súkromie skenovaním a vymazaním vyrovnávacej pamäte webového prehliadača a miestnych súborov cookie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaščitite svojo zasebnost s skeniranjem in brisanjem predpomnilnika spletnega brskalnika in lokalnih piškotkov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skydda din integritet genom att skanna och rensa webbläsarens cacheminne och lokala cookies."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இணைய உலாவி தற்காலிக சேமிப்புகள் மற்றும் உள்ளூர் குக்கீகளை ஸ்கேன் செய்து அழிப்பதன் மூலம் உங்கள் தனியுரிமையைப் பாதுகாக்கவும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过扫描和清除网络浏览器缓存和本地 cookie 来保护您的隐私。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過掃描和清除網頁瀏覽器快取和本機 cookie 來保護您的隱私。"
          }
        }
      }
    },
